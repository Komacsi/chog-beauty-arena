[Unit]
Description=Read-only Chog Arena health check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=chogmonitor
Group=chogmonitor
WorkingDirectory=/opt/chog-arena
EnvironmentFile=/etc/chog-arena/public.env
Environment=KEEPER_HEALTH_PATH=/run/chog-keeper-health/status.json
Environment=MONITOR_TELEGRAM=1
LoadCredential=telegram.json:/etc/chog-arena/telegram.json
StateDirectory=chog-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/node scripts/monitor.mjs
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
