PORT=3000
HOST=127.0.0.1
MONAD_RPC_URL=https://rpc.monad.xyz
IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
# Set after deploying BeautyArena to enable real CHOG transactions.
ARENA_CONTRACT_ADDRESS=
# Public initial keeper address; governance can revoke/replace it.
ARENA_REVEALER_ADDRESS=
# Verified Safe 1.5.0, >=2 confirmations, no enabled modules.
ARENA_GOVERNANCE_ADDRESS=
# Encrypted keystore/password files outside the source checkout. No raw key in env.
KEEPER_KEYSTORE_PATH=
KEEPER_PASSWORD_FILE=
# Contract deployment block; obtain it from the deployment transaction receipt.
KEEPER_FROM_BLOCK=
# Demo: two-minute betting window; use 0 to simulate 24h (live always remains 24h).
DEMO_FAST_ROUNDS=1

# Read-only monitor: low gas alert and bounded recent-round scan.
KEEPER_MIN_MON=0.1
MONITOR_MAX_ROUNDS=200
